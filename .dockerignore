# Rust build output (rebuilt inside the image)
target/
**/target/

# Node deps & build output (reinstalled/rebuilt inside the image)
node_modules/
**/node_modules/
**/dist/
**/.vite/

# Secrets — never copy into the build context
.env
.env.*
!.env.example

# Large archives / VCS / editor noise
*.7z
*.zip
*.rar
.git/
.vscode/
.idea/
*.log

# Docs / plans not needed for the build (excluded so a docs edit doesn't bust
# the builder's source-copy layer and force a recompile)
@plans/
@arch/
*.md
target-check/
