# =============================================================================
# Copy to .env and fill in. Single source of truth for the WHOLE product:
#   - Backend reads this via dotenvy (PANICS on startup if a required var is missing).
#   - Frontend (Vite) reads VITE_* from THIS file via envDir='..'.
#   - Docker reads it via env_file / build-args (see deploy/hunter-*/compose.yml).
# .env is gitignored — never commit real secrets. Keep this file schema-identical
# to .env (same keys, same order) — only the values differ.
# NOTE: anything VITE_*-prefixed is baked into the public JS bundle. Never give
# a secret a VITE_ prefix.
# =============================================================================

# --- Helius (required) -------------------------------------------------------
HELIUS_API_KEY={your_helius_api_key_here}
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key={your_helius_api_key_here}
# LaserStream (Yellowstone gRPC) ingest endpoint — the sole live transport. Auth
# reuses HELIUS_API_KEY. Pick the region nearest the server: fra ams lon | ewr
# pitt slc lax | tyo sg. Needs a Business/Professional Helius plan.
HELIUS_LASERSTREAM_URL=https://laserstream-mainnet-<region>.helius-rpc.com
# Helius Sender endpoint for submitting txs (send-only; Jito + SWQoS in parallel;
# 0 credits; no api-key). Regional /fast nearest the server. Requires a Jito tip
# AND a priority fee (the trader attaches both).
HELIUS_FAST_SENDER_URL=http://fra-sender.helius-rpc.com/fast
# Optional multi-endpoint fan-out (comma-separated). Same signed tx to all → the
# bank dedups, tip paid once; extra endpoints only add landing paths. OVERRIDES
# HELIUS_FAST_SENDER_URL when set. Do NOT append ?swqos_only=true for snipes.
HELIUS_FAST_SENDER_URLS=http://fra-sender.helius-rpc.com/fast,http://ams-sender.helius-rpc.com/fast

# --- Solana / wallet (required) ---------------------------------------------
# Hot wallet private key used to sign trades. SENSITIVE — keep secret.
WALLET_PRIVATE_KEY=your_base58_private_key
# Comma-separated durable-nonce account pubkeys.
NONCE_ACCOUNTS=pubkey1,pubkey2

# --- Database ---------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=meme_bot
# Connection string for running the backend WITHOUT docker (host → published port).
# Under docker, compose sets DATABASE_URL/HOST/PORT and overrides anything here.
DATABASE_URL=postgres://postgres:change_me@localhost:5555/meme_bot
# (postgres host-publish port lives in the PORTS block below, as DB_PORT.)
# Three workload-isolated connection pools (hot / api / batch) so no class of work
# starves another. Sized to actual concurrency, not the server ceiling — each open
# PG backend is ~26MB on the 4GB box. Keep the sum well under POSTGRES_MAX_CONNECTIONS.
DB_MAX_CONNECTIONS=12
DB_MIN_CONNECTIONS=2
DB_API_MAX_CONNECTIONS=8
DB_API_MIN_CONNECTIONS=1
DB_BATCH_MAX_CONNECTIONS=2
DB_BATCH_MIN_CONNECTIONS=1
# Seconds to wait for a free connection before erroring (per acquire).
DB_ACQUIRE_TIMEOUT_SECS=10
# Postgres server-side ceiling + shared-buffer cache (consumed by compose).
POSTGRES_MAX_CONNECTIONS=80
POSTGRES_SHARED_BUFFERS=256MB

# --- Backend HTTP server ----------------------------------------------------
# Local dev bind (WITHOUT docker). live and lab bind different ports so both can
# run at once with no inline PORT override. In docker, compose injects HOST=0.0.0.0
# / PORT (the *_API_PORT below) which take precedence over these.
LIVE_HOST=127.0.0.1
LIVE_PORT=8081
LAB_HOST=127.0.0.1
LAB_PORT=8082
HTTP_ENABLED=true
HTTP_WORKERS=2
# Bearer token gating ALL mutating (POST/PUT/DELETE/PATCH) API routes, incl. the
# real-SOL buy/sell endpoints. FAIL-CLOSED: the backend refuses to start without
# it. Clients send `Authorization: Bearer <token>`. Generate a fresh secret, e.g.
# `head -c 32 /dev/urandom | base64`.
API_AUTH_TOKEN=generate_a_long_random_secret_here

# --- PORTS (deploy/hunter.compose.yml — shared deploy server) ----------------
# Every host/service port in ONE place. Number scheme  8·F·C·P :
#   8 fixed · F=family (1 hunter, 2 forge) · C=component (1 live-ui, 2 lab-ui,
#   3 live-api, 4 lab-api) · P=protocol (0 http, 1 https; api uses 0).
#   e.g. 8121 = hunter·lab-ui·https ; 8140 = hunter·lab-api. DB keeps 5555/5556.
# All 12 ports are collision-free across both stacks (forge omits the lab-ui pair
# — forge-lab is API-only). live-api is NOT host-published (reached only through
# nginx); lab-api IS (direct access + `run --rm` batch). To make compose read
# these (not just its built-in defaults), pass --env-file:
#   docker compose --env-file hunter/.env -f deploy/hunter.compose.yml up -d --build
DB_PORT=5555             # postgres  (host -> container 5432)
LIVE_UI_HTTP_PORT=8110   # live nginx UI, published
LIVE_UI_HTTPS_PORT=8111
LAB_UI_HTTP_PORT=8120    # lab  nginx UI, published
LAB_UI_HTTPS_PORT=8121
LIVE_API_PORT=8130       # live backend: container bind + nginx upstream (NOT host-published)
LAB_API_PORT=8140        # lab  backend: container bind + nginx upstream + host-published

# --- Lab sweep / Parquet lake (lab-only, never deployed) --------------------
# Where `lab lake-export` writes / grouped sweeps read the Parquet lake. Persistent
# path keeps the lake across runs (default when unset: OS-temp `pumpfun-lake`).
SWEEP_LAKE_DIR=./lake-data

# --- Frontend (VITE_*; baked into the static bundle — no secrets here) -------
# Empty => SPA calls relative /api (Vite dev proxy / nginx forwards it).
VITE_API_BASE=
VITE_POLL_INTERVAL_MS=2000
# Dev-server only: per-app /api proxy targets (Vite live :5173, lab :5174).
VITE_LIVE_DEV_PROXY_TARGET=http://127.0.0.1:8081
VITE_LAB_DEV_PROXY_TARGET=http://127.0.0.1:8082
