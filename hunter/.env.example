# =============================================================================
# hunter config template — copy to .env and fill in. Single source of truth for
# the WHOLE product (backend + frontend).
#   - Backend reads it via dotenvy (PANICS on startup if a required var is missing).
#   - Frontend (Vite) reads the VITE_* vars from this file via envDir='..'.
#   - Docker reads it via env_file / build-args (deploy/hunter-*/compose.yml).
#   - .env is gitignored; never commit real secrets.
# Keep this file schema-identical to .env: same keys, same order — only values differ.
# WARNING: any VITE_*-prefixed var is baked into the public JS bundle. Never give
# a secret a VITE_ prefix.
# =============================================================================

# =========================== Helius (required) ===============================

HELIUS_API_KEY={your_helius_api_key_here}
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key={your_helius_api_key_here}

# LaserStream (Yellowstone gRPC) ingest endpoint — the sole live transport; auth
# reuses HELIUS_API_KEY. Pick the region nearest the server: fra ams lon | ewr
# pitt slc lax | tyo sg. Needs a Business/Professional Helius plan.
HELIUS_LASERSTREAM_URL=https://laserstream-mainnet-<region>.helius-rpc.com

# Helius Sender send endpoint (send-only; Jito + SWQoS in parallel; 0 credits; no
# api-key). Regional /fast nearest the server. Requires a Jito tip AND a priority
# fee (the trader attaches both).
HELIUS_FAST_SENDER_URL=http://fra-sender.helius-rpc.com/fast

# Optional multi-endpoint fan-out (comma-separated). Same signed tx to all -> the
# bank dedups and the tip is paid once; extra endpoints only add landing paths.
# OVERRIDES HELIUS_FAST_SENDER_URL when set. Do NOT append ?swqos_only=true for snipes.
# Latency tip: rank on the LIVE box and pin the fastest 1–2 acceptors:
#   cargo run -p hunter-live -- probe pin-senders --write-env
# (dry-run without --write-env; --keep 1 pins only the winner for the direct-await path)
HELIUS_FAST_SENDER_URLS=http://fra-sender.helius-rpc.com/fast,http://ams-sender.helius-rpc.com/fast

# =========================== Trade fees / tips (live) ========================
# Applied to every buy/sell via Helius Sender. Tip + priority fee are both required.
# Tip is sized from Jito's live landed-tip feed at PERCENTILE, then max'd with
# MIN×1.5^level on retries (so a quiet market still bids up off the floor), and
# clamped to [MIN, MAX]. Tip goes to a Helius Sender wallet (not a Jito account).
#   MIN 0.001 = Sender Max priority-tip-buffer (full pathways). Tips in
#   [0.000005, 0.001) are accepted but best-effort / fewer pathways; hard reject
#   below 0.0002. Raise MAX only if contested slots need a higher re-bid ceiling.
JITO_MIN_TIP_SOL=0.001
JITO_MAX_TIP_SOL=0.005
JITO_TIP_PERCENTILE=75
# Priority-fee rate (micro-lamports per CU). Fee ≈ price × CU_limit / 1e6 lamports.
# Curve buy/sell limits are ~150k/100k CU → ~0.00003 / ~0.00002 SOL at default.
CU_PRICE_MICRO_LAMPORTS=200000

# =========================== Solana / wallet (required) ======================

# Hot wallet private key used to sign trades. SENSITIVE — keep secret.
WALLET_PRIVATE_KEY=your_base58_private_key

# Durable-nonce account pubkeys (comma-separated).
NONCE_ACCOUNTS=pubkey1,pubkey2

# =========================== Database ========================================

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=hunter_bot

# Connection string for running the backend WITHOUT docker (host -> published DB_PORT).
# Under docker, compose sets DATABASE_URL/HOST/PORT and overrides anything here.
DATABASE_URL=postgres://postgres:change_me@localhost:5555/hunter_bot

# Workload-isolated pools (hot / api / batch) so no class of work starves another.
# Sized to actual concurrency, not the server ceiling — each open backend is ~26MB
# on the 4GB box. Keep their sum well under POSTGRES_MAX_CONNECTIONS.
DB_MAX_CONNECTIONS=12
DB_MIN_CONNECTIONS=2
DB_API_MAX_CONNECTIONS=8
DB_API_MIN_CONNECTIONS=1
DB_BATCH_MAX_CONNECTIONS=2
DB_BATCH_MIN_CONNECTIONS=1

# Seconds to wait for a free connection before erroring (per acquire).
DB_ACQUIRE_TIMEOUT_SECS=10

# Postgres server-side ceiling + shared-buffer cache (read by compose).
POSTGRES_MAX_CONNECTIONS=80
POSTGRES_SHARED_BUFFERS=256MB

# =========================== HTTP server (local dev bind) ====================
# Bind used WITHOUT docker. live and lab bind different ports so both can run at
# once. These match LIVE_API_PORT / LAB_API_PORT below, so `cargo run` and docker
# use the same port. Under docker, compose injects HOST=0.0.0.0 / PORT (the
# *_API_PORT below) and overrides these.

LIVE_HOST=127.0.0.1
LIVE_PORT=8130

LAB_HOST=127.0.0.1
LAB_PORT=8140

HTTP_ENABLED=true
HTTP_WORKERS=2

# =========================== API auth ========================================
# Bearer token gating ALL mutating (POST/PUT/DELETE/PATCH) API routes, incl. the
# real-SOL buy/sell endpoints. FAIL-CLOSED: the backend refuses to start without
# it. Clients send `Authorization: Bearer <token>`. Generate: head -c 32 /dev/urandom | base64

API_AUTH_TOKEN=generate_a_long_random_secret_here

# =========================== Deploy ports (hunter.compose.yml) ===============
# Every host/service port in ONE place. Scheme  8·F·C·P :
#   8 fixed · F=family (1 hunter, 2 forge) · C=component (1 live-ui, 2 lab-ui,
#   3 live-api, 4 lab-api) · P=protocol (0 http, 1 https; api uses 0).
#   e.g. 8121 = hunter·lab-ui·https ; 8140 = hunter·lab-api. DB keeps 5555/5556.
# All 12 ports are collision-free across both stacks (forge omits the lab-ui pair
# — forge-lab is API-only). live-api is NOT host-published (only nginx reaches it);
# lab-api IS (direct access + `run --rm` batch).
# Make compose read these (not just its built-in defaults) with --env-file:
#   docker compose --env-file hunter/.env -f deploy/hunter.compose.yml up -d --build
DB_PORT=5555             # postgres  (host -> container 5432)
LIVE_UI_HTTP_PORT=8110   # live nginx UI, published
LIVE_UI_HTTPS_PORT=8111
LAB_UI_HTTP_PORT=8120    # lab  nginx UI, published
LAB_UI_HTTPS_PORT=8121
LIVE_API_PORT=8130       # live backend: container bind + nginx upstream (not host-published)
LAB_API_PORT=8140        # lab  backend: container bind + nginx upstream + host-published

# =========================== Lab sweep / Parquet lake ========================
# lab-only, never deployed.

# Where `lab lake-export` writes / grouped sweeps read the Parquet lake, and where
# finished single-rule sim results are cached (`<dir>/sim-results/`). A persistent
# path keeps both across lab restarts (default when unset: OS-temp `pumpfun-lake`).
SWEEP_LAKE_DIR=./lake-data

# =========================== Strategy event log (live) =======================
# The generic strategy engine appends every decision-driving event to a local
# append-only JSONL log (rotated daily), for time-travel debugging + boot recovery.
# Not a secret — a local directory path. Ticks are never logged (regenerable).

# Directory the event log is written to (created if missing; default: ./event_log).
EVENT_LOG_DIR=./event_log
# Days of rotated logs to retain before pruning (default: 7).
EVENT_LOG_RETENTION_DAYS=7

# =========================== Frontend (VITE_*) ===============================
# Baked into the static bundle — NO secrets here.

# Empty => the SPA calls relative /api (Vite dev proxy / nginx forwards it).
VITE_API_BASE=
VITE_POLL_INTERVAL_MS=2000
# Tokens STREAM safety-net poll (SSE is primary; heals sort + missed frames).
VITE_FALLBACK_POLL_INTERVAL_MS=90000

# Dev-server only: per-app /api proxy targets (Vite live :5173, lab :5174).
VITE_LIVE_DEV_PROXY_TARGET=http://127.0.0.1:8130
VITE_LAB_DEV_PROXY_TARGET=http://127.0.0.1:8140
