# =============================================================================
# hunter config template — copy to .env and fill in. Single source of truth for
# the WHOLE product (backend + frontend).
#   - Backend reads it via dotenvy (PANICS on startup if a required var is missing).
#   - Frontend (Vite) reads the VITE_* vars from this file via envDir='..'.
#   - Docker reads it via env_file / build-args (deploy/hunter-*/compose.yml).
#   - .env is gitignored; never commit real secrets.
# Keep this file schema-identical to .env: same keys, same order — only values differ.
# WARNING: any VITE_*-prefixed var is baked into the public JS bundle. Never give
# a secret a VITE_ prefix.
# =============================================================================

# =========================== Helius (required) ===============================

HELIUS_API_KEY={your_helius_api_key_here}
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key={your_helius_api_key_here}

# LaserStream (Yellowstone gRPC) ingest endpoint — the sole live transport; auth
# reuses HELIUS_API_KEY. Pick the region nearest the server: fra ams lon | ewr
# pitt slc lax | tyo sg. Needs a Business/Professional Helius plan.
HELIUS_LASERSTREAM_URL=https://laserstream-mainnet-<region>.helius-rpc.com

# Helius Sender send endpoint (send-only; Jito + SWQoS in parallel; 0 credits; no
# api-key). Regional /fast nearest the server. Requires a Jito tip AND a priority
# fee (the trader attaches both).
HELIUS_FAST_SENDER_URL=http://fra-sender.helius-rpc.com/fast

# Optional multi-endpoint fan-out (comma-separated). Same signed tx to all -> the
# bank dedups and the tip is paid once; extra endpoints only add landing paths.
# OVERRIDES HELIUS_FAST_SENDER_URL when set. Do NOT append ?swqos_only=true for snipes.
# Latency tip: rank on the LIVE box and pin the fastest 1–2 acceptors:
#   cargo run -p hunter-live -- probe pin-senders --write-env
# (dry-run without --write-env; --keep 1 pins only the winner for the direct-await path)
HELIUS_FAST_SENDER_URLS=http://fra-sender.helius-rpc.com/fast,http://ams-sender.helius-rpc.com/fast

# =========================== Trade fees / tips (live) ========================
# Applied to every buy/sell via Helius Sender. Tip + priority fee are both required.
# Tip is sized from Jito's live landed-tip feed at PERCENTILE, then max'd with
# MIN×1.5^level on retries (so a quiet market still bids up off the floor), and
# clamped to [MIN, MAX]. Tip goes to a Helius Sender wallet (not a Jito account).
#   HARD FLOOR (measured 2026-08-03 against the live /fast endpoint: 199999 lamports
#   -> -32602, 200000 -> accepted): the Sender rejects ANY tx tipping < 200000
#   lamports = 0.0002 SOL, PRE-BROADCAST, so the tx never reaches the chain. MIN
#   below that = every trade silently dies. Re-measure by POSTing a tip-less tx to
#   the /fast endpoint; the -32602 payload names the current floor + wallet list.
#   Sender tiers: >=0.001 = Max priority-tip-buffer (top-of-block, ALL pathways);
#   [0.0002, 0.001) = accepted but no buffer, fewer pathways, best-effort.
#   MIN is what almost every trade actually pays: buys go Ambiguous (no engine
#   resubmit), so they land or die on the level-0 tip and never climb the ladder.
#   MAX therefore only reaches sells (reaper redrives) and post-revert buy retries.
#   0.0002 sits EXACTLY on the hard floor -- zero margin, and that floor has moved
#   before (0.000005 -> 0.0002). Chosen deliberately: tip is fixed SOL/leg, so at a
#   0.01 SOL buy size 0.001 would be 20% of the position per round trip (break-even
#   ~23%) vs ~4% here. Raise MIN toward 0.001 if buy size rises or fills look
#   adversely selected. MAX is a busy-chain ceiling, NOT a per-trade cost (quiet
#   markets size at ~p50, tiny; a tx that never lands costs 0).
#   History: 0.0001/0.0005 capped the tip below the floor -> 0/4 real buys landed
#   2026-07-24; raised to 0.001/0.005. The BOX then regressed to 0.00001 (10000
#   lamports, 20x under the floor) -> 0/13 real buys broadcast 2026-07-31..08-03,
#   invisible because the send error is discarded. Now 0.0002/0.0006.
#   The box .env is NOT in git -- fixing it here does NOT fix the server.
# Lab (simulate / grouped-sweep) also reads MIN + CU_PRICE into CostModel's
# fixed per-leg cost — same FeeTuning SSOT as live — so changing these updates
# both the trader bid and backtest haircuts. Restart lab after edits.
JITO_MIN_TIP_SOL=0.0002
JITO_MAX_TIP_SOL=0.0006
JITO_TIP_PERCENTILE=50
# Priority-fee rate (micro-lamports per CU). Fee ≈ price × CU_limit / 1e6 lamports.
# Curve buy/sell limits are ~150k/100k CU → ~0.00003 / ~0.00002 SOL at default.
# With the tip below the Sender buffer this is the main remaining landing edge,
# and it is far cheaper per unit of priority than tip. Raise to ~600000
# (~0.00009 SOL/buy, above pump.fun's contested-slot p99) if trades miss blocks.
CU_PRICE_MICRO_LAMPORTS=200000

# =========================== Solana / wallet (required) ======================

# Hot wallet private key used to sign trades. SENSITIVE — keep secret.
WALLET_PRIVATE_KEY=your_base58_private_key

# Durable-nonce account pubkeys (comma-separated).
NONCE_ACCOUNTS=pubkey1,pubkey2

# =========================== Database ========================================

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=hunter_bot

# Connection string for running the backend WITHOUT docker (host -> published DB_PORT).
# Under docker, compose sets DATABASE_URL/HOST/PORT and overrides anything here.
DATABASE_URL=postgres://postgres:change_me@localhost:5555/hunter_bot

# Workload-isolated pools (hot / api / batch) so no class of work starves another.
# Sized to actual concurrency, not the server ceiling — each open backend is ~26MB
# on the 4GB box. Keep their sum well under POSTGRES_MAX_CONNECTIONS.
DB_MAX_CONNECTIONS=12
DB_MIN_CONNECTIONS=2
DB_API_MAX_CONNECTIONS=8
DB_API_MIN_CONNECTIONS=1
DB_BATCH_MAX_CONNECTIONS=2
DB_BATCH_MIN_CONNECTIONS=1

# Seconds to wait for a free connection before erroring (per acquire).
DB_ACQUIRE_TIMEOUT_SECS=10

# Postgres server-side ceiling + shared-buffer cache (read by compose).
POSTGRES_MAX_CONNECTIONS=80
POSTGRES_SHARED_BUFFERS=256MB

# /dev/shm cap for the postgres container. Parallel-query DYNAMIC shared memory
# lives here, NOT in shared_buffers; Docker's 64MB default runs out mid-query
# ("could not resize shared memory segment ... No space left on device"). A tmpfs
# cap, not a reservation — only what is in use costs RAM.
POSTGRES_SHM_SIZE=1gb

# =========================== Process runtime (live, optional) ================
# tokio worker threads for the live bin. Blank/unset = one per CPU core
# (available_parallelism) — 2 on the EC2 box, the full count on the workstation.
# Set explicitly only to A/B scheduling latency on the snipe path; oversubscribing
# an IO-bound runtime adds latency for the runnable task, it does not add
# throughput. The value actually used is logged at boot ("🧵 tokio runtime").

WORKER_THREADS=

# =========================== HTTP server (local dev bind) ====================
# Bind used WITHOUT docker. live and lab bind different ports so both can run at
# once. These match LIVE_API_PORT / LAB_API_PORT below, so `cargo run` and docker
# use the same port. Under docker, compose injects HOST=0.0.0.0 / PORT (the
# *_API_PORT below) and overrides these.

LIVE_HOST=127.0.0.1
LIVE_PORT=8130

LAB_HOST=127.0.0.1
LAB_PORT=8140

HTTP_ENABLED=true
HTTP_WORKERS=2

# =========================== API auth ========================================
# Bearer token gating ALL mutating (POST/PUT/DELETE/PATCH) API routes, incl. the
# real-SOL buy/sell endpoints. FAIL-CLOSED: the backend refuses to start without
# it. Clients send `Authorization: Bearer <token>`. Generate: head -c 32 /dev/urandom | base64

API_AUTH_TOKEN=generate_a_long_random_secret_here

# =========================== Deploy ports (hunter.compose.yml) ===============
# Every host/service port in ONE place. Scheme  8·F·C·P :
#   8 fixed · F=family (1 hunter, 2 forge) · C=component (1 live-ui, 2 lab-ui,
#   3 live-api, 4 lab-api) · P=protocol (0 http, 1 https; api uses 0).
#   e.g. 8121 = hunter·lab-ui·https ; 8140 = hunter·lab-api. DB keeps 5555/5556.
# All 12 ports are collision-free across both stacks (forge omits the lab-ui pair
# — forge-lab is API-only). live-api is NOT host-published (only nginx reaches it);
# lab-api IS (direct access + `run --rm` batch).
# Make compose read these (not just its built-in defaults) with --env-file:
#   docker compose --env-file hunter/.env -f deploy/hunter.compose.yml up -d --build
DB_PORT=5555             # postgres  (host -> container 5432)
LIVE_UI_HTTP_PORT=8110   # live nginx UI, published
LIVE_UI_HTTPS_PORT=8111
LAB_UI_HTTP_PORT=8120    # lab  nginx UI, published
LAB_UI_HTTPS_PORT=8121
LIVE_API_PORT=8130       # live backend: container bind + nginx upstream (not host-published)
LAB_API_PORT=8140        # lab  backend: container bind + nginx upstream + host-published

# =========================== Lab sweep / Parquet lake ========================
# lab-only, never deployed.

# Where `lab lake-export` writes / grouped sweeps read the Parquet lake, and where
# finished single-rule sim results are cached (`<dir>/sim-results/`). A persistent
# path keeps both across lab restarts (default when unset: OS-temp `pumpfun-lake`).
# Relative ⇒ resolved against THIS FILE's directory (hunter/), not the shell's CWD,
# so the lake is the same one from any launch dir; absolute is used verbatim (deploy
# sets /lake on the hunter-lakedata volume). Same rule as EVENT_LOG_DIR below.
SWEEP_LAKE_DIR=./lake-data

# =========================== Strategy event log (live) =======================
# The generic strategy engine appends every decision-driving event to a local
# append-only JSONL log (rotated by day AND by size), for time-travel debugging +
# boot recovery. Not a secret — local paths and sizes. Ticks are never logged
# (regenerable). Boot recovery reads only ~5.5 minutes of tail; the rest of the
# corpus exists for the lab replay inspector, which does not run on the live box.

# Directory the event log is written to (created if missing; default: ./event_log).
# A RELATIVE path is resolved against THIS FILE's directory (hunter/), not the
# shell's CWD — so `cargo run -p hunter-live` writes the same place from the repo
# root, hunter/, or hunter/live/. An absolute path is used verbatim; deploy sets
# one (`EVENT_LOG_DIR=/var/lib/hunter/event_log` on a named volume in
# deploy/hunter.compose.yml) so the log survives a container rebuild.
EVENT_LOG_DIR=./event_log
# Days of logs to retain before pruning (default: 7). A SECONDARY bound — days
# cannot bound bytes when one day is 4+ GB. EVENT_LOG_MAX_BYTES is the real limit.
EVENT_LOG_RETENTION_DAYS=7
# Hard byte budget for the whole log directory (default: 6442450944 = 6 GiB).
# Oldest segments are evicted until the directory fits. Set this LOW on the live
# EC2 box (536870912 = 512 MiB is ~3 hours of history, 30x what recovery needs).
EVENT_LOG_MAX_BYTES=6442450944
# Roll to a new segment (`events-YYYY-MM-DD.NN.jsonl`) once the open file passes
# this many bytes (default: 268435456 = 256 MiB; floor 1 MiB, clamped to
# EVENT_LOG_MAX_BYTES). Keep it well above the ~15 MB recovery window so a boot
# scan stays inside one file, and well below the budget so there is always
# something evictable behind the open segment — the open one is never deleted.
EVENT_LOG_SEGMENT_BYTES=268435456

# =========================== Exit recovery (live, optional) ==================
# Stranded-bag recovery normally decides "is the bag gone?" from the Postgres
# `trades` net alone (no RPC). That is blind twice over: an ingest feed gap hides
# a sell that DID land, and a bag sitting in a token account no position row
# references is invisible to any PG query. This opt-in check answers both with one
# `getTokenAccountsByOwner` — it returns every account for the mint with its
# balance, so the reaper can book a cleared row, or re-point one at the account
# actually holding its tokens, instead of parking it for a human.

# Spends Helius credits, so it is OFF by default. Bounded by construction: only
# rows about to be parked reach it (never the hot path) — a handful per day.
EXIT_BAG_ONCHAIN_CHECK=false

# =========================== Latency tracing (live, optional) ===============
# Carries the transport receive stamp on TRADE pings, so the `snipe_latency` log
# line reports `recv_to_ping_ms` / `ping_to_decide_ms` for a flow-triggered rule.
# Without it those two fields exist only for create-lane (snipe) entries and a
# flow scalper's line carries `decide_to_ack_ms` alone.

# OFF by default and meant to be turned on for a measuring window, not left on:
# the create lane pings a few times a second, the trade lane hundreds, and each
# stamp costs a mint String clone + a DashMap insert. Zero cost when unset.
LATENCY_TRACE=false

# =========================== Frontend (VITE_*) ===============================
# Baked into the static bundle — NO secrets here.

# Empty => the SPA calls relative /api (Vite dev proxy / nginx forwards it).
VITE_API_BASE=
# Tokens STREAM safety-net poll (SSE is primary; heals sort + missed frames).
VITE_FALLBACK_POLL_INTERVAL_MS=90000

# Dev-server only: per-app /api proxy targets (Vite live :5173, lab :5174).
VITE_LIVE_DEV_PROXY_TARGET=http://127.0.0.1:8130
VITE_LAB_DEV_PROXY_TARGET=http://127.0.0.1:8140
