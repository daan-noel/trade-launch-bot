{
  "name": "frontend-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n live,lab -c blue,magenta \"npm:dev:live\" \"npm:dev:lab\"",
    "dev:live": "vite --host --config vite.live.config.ts",
    "dev:lab": "vite --host --config vite.lab.config.ts",
    "build:live": "tsc && vite build --config vite.live.config.ts",
    "build:lab": "tsc && vite build --config vite.lab.config.ts",
    "preview": "vite preview --config vite.live.config.ts",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.1.2",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.6"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "@tailwindcss/vite": "^4.3.0",
    "clsx": "^2.1.1",
    "fancy-canvas": "^2.1.0",
    "lightweight-charts": "^5.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.16.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0"
  }
}
