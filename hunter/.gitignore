# Rust build output
/target/
target-check
# NOTE: Cargo.lock is intentionally COMMITTED. This is a binary/app, not a
# library, so the lockfile must be tracked — it keeps the dependency graph
# deterministic across machines and lets cargo-chef's Docker layer cache hit
# on EC2 (otherwise every redeploy re-downloads & recompiles all crates).

# Frontend - React/Vite
frontend/dist/
frontend/build/
frontend/node_modules/
frontend/.vite/
package-lock.json

# Strategy sweep output (corpus parquet cache + run artifacts)
sweep-out/
tpsl2-sweep-out/
venv

# Environment secrets
.env
.env.backup
.env.local
.env.*.local

# TLS cert + private key (self-signed, generated locally — regenerate via openssl;
# see nginx/tls/README.md). Required locally before `docker compose up --build`.
nginx/tls/*.pem

# SSH keys — never commit
*.pem
*.ppk
aws.pub

