{
  "_comment": [
    "Shared tagged/untagged classification vectors, asserted by BOTH implementations:",
    "  Rust  hunter/engine/src/metrics/flow_ix.rs  (the SSOT the engine decides on)",
    "  TS    hunter/frontend/src/shared/lib/flow/classifyFlow.ts  (the chart's port)",
    "",
    "The two are separate code because the chart must redraw without a round trip.",
    "That is only safe while they agree, and 'they look the same' is not a test —",
    "the pair has drifted before and the failure is silent, because a misclassified",
    "trade still produces a plausible number. Every case below fixes one rule of the",
    "classifier; add a case here, not to one suite, when the rules change.",
    "",
    "`patterns` are ordered ix_labels sequences. Trades are in canonical order",
    "(slot -> tx_index -> leg_index); contagion is forward-only, so order is load-",
    "bearing and the arrays must not be re-sorted by either reader."
  ],
  "cases": [
    {
      "name": "structural match only",
      "patterns": [["Pump.Fun: Create", "Pump.Fun: Buy"]],
      "creator": null,
      "trades": [
        { "wallet": "w1", "side": "buy", "sol": 2.0, "labels": ["Pump.Fun: Create", "Pump.Fun: Buy"] },
        { "wallet": "w2", "side": "buy", "sol": 3.0, "labels": ["Pump.Fun: Buy"] }
      ],
      "expect": { "tagged_buy": 2.0, "tagged_sell": 0.0, "untagged_buy": 3.0, "untagged_sell": 0.0 }
    },
    {
      "name": "contagion: a tagged wallet stays volume whatever its later structure",
      "patterns": [["Pump.Fun: Create", "Pump.Fun: Buy"]],
      "creator": null,
      "trades": [
        { "wallet": "w1", "side": "buy", "sol": 2.0, "labels": ["Pump.Fun: Create", "Pump.Fun: Buy"] },
        { "wallet": "w1", "side": "sell", "sol": 1.5, "labels": ["Pump.Fun: Sell"] },
        { "wallet": "w1", "side": "buy", "sol": 0.5, "labels": null }
      ],
      "expect": { "tagged_buy": 2.5, "tagged_sell": 1.5, "untagged_buy": 0.0, "untagged_sell": 0.0 }
    },
    {
      "name": "contagion is FORWARD-only: trades before the tagging match stay organic",
      "patterns": [["Pump.Fun: Create", "Pump.Fun: Buy"]],
      "creator": null,
      "trades": [
        { "wallet": "w1", "side": "buy", "sol": 4.0, "labels": ["Pump.Fun: Buy"] },
        { "wallet": "w1", "side": "buy", "sol": 1.0, "labels": ["Pump.Fun: Create", "Pump.Fun: Buy"] },
        { "wallet": "w1", "side": "sell", "sol": 2.0, "labels": ["Pump.Fun: Sell"] }
      ],
      "expect": { "tagged_buy": 1.0, "tagged_sell": 2.0, "untagged_buy": 4.0, "untagged_sell": 0.0 }
    },
    {
      "name": "creator is volume-side with no pattern configured at all",
      "patterns": [],
      "creator": "dev",
      "trades": [
        { "wallet": "dev", "side": "buy", "sol": 5.0, "labels": null },
        { "wallet": "w1", "side": "buy", "sol": 1.0, "labels": ["Pump.Fun: Buy"] }
      ],
      "expect": { "tagged_buy": 5.0, "tagged_sell": 0.0, "untagged_buy": 1.0, "untagged_sell": 0.0 }
    },
    {
      "name": "creator seeds contagion — the dev dump is volume too",
      "patterns": [],
      "creator": "dev",
      "trades": [
        { "wallet": "dev", "side": "buy", "sol": 5.0, "labels": null },
        { "wallet": "dev", "side": "sell", "sol": 4.0, "labels": null }
      ],
      "expect": { "tagged_buy": 5.0, "tagged_sell": 4.0, "untagged_buy": 0.0, "untagged_sell": 0.0 }
    },
    {
      "name": "exact ORDER matters — a reordered sequence is a different pattern",
      "patterns": [["Pump.Fun: Create", "Pump.Fun: Buy"]],
      "creator": null,
      "trades": [
        { "wallet": "w1", "side": "buy", "sol": 1.0, "labels": ["Pump.Fun: Buy", "Pump.Fun: Create"] }
      ],
      "expect": { "tagged_buy": 0.0, "tagged_sell": 0.0, "untagged_buy": 1.0, "untagged_sell": 0.0 }
    },
    {
      "name": "a trailing extra label is a MISS, not a prefix match",
      "patterns": [["Pump.Fun: CreateIdempotent", "Pump.Fun: Buy"]],
      "creator": null,
      "trades": [
        {
          "wallet": "w1",
          "side": "buy",
          "sol": 1.0,
          "labels": ["Pump.Fun: CreateIdempotent", "Pump.Fun: Buy", "System Program: Transfer"]
        }
      ],
      "expect": { "tagged_buy": 0.0, "tagged_sell": 0.0, "untagged_buy": 1.0, "untagged_sell": 0.0 }
    },
    {
      "name": "duplicate labels are kept — count is part of the identity",
      "patterns": [["System Program: Transfer", "Pump.Fun: Buy", "System Program: Transfer"]],
      "creator": null,
      "trades": [
        {
          "wallet": "w1",
          "side": "buy",
          "sol": 2.0,
          "labels": ["System Program: Transfer", "Pump.Fun: Buy", "System Program: Transfer"]
        },
        { "wallet": "w2", "side": "buy", "sol": 3.0, "labels": ["System Program: Transfer", "Pump.Fun: Buy"] }
      ],
      "expect": { "tagged_buy": 2.0, "tagged_sell": 0.0, "untagged_buy": 3.0, "untagged_sell": 0.0 }
    },
    {
      "name": "missing labels never match, not even an empty configured pattern",
      "patterns": [[]],
      "creator": null,
      "trades": [
        { "wallet": "w1", "side": "buy", "sol": 1.0, "labels": null },
        { "wallet": "w2", "side": "buy", "sol": 2.0, "labels": [] }
      ],
      "expect": { "tagged_buy": 0.0, "tagged_sell": 0.0, "untagged_buy": 3.0, "untagged_sell": 0.0 }
    },
    {
      "name": "nothing configured and no creator — everything is organic",
      "patterns": [],
      "creator": null,
      "trades": [
        { "wallet": "w1", "side": "buy", "sol": 1.0, "labels": ["Pump.Fun: Buy"] },
        { "wallet": "w2", "side": "sell", "sol": 2.0, "labels": ["Pump.Fun: Sell"] }
      ],
      "expect": { "tagged_buy": 0.0, "tagged_sell": 0.0, "untagged_buy": 1.0, "untagged_sell": 2.0 }
    }
  ]
}
