# =============================================================================
# Copy to .env and fill in. Single source of truth for the WHOLE project:
#   - Backend reads this via dotenvy (PANICS on startup if a required var is missing).
#   - Frontend (Vite) reads VITE_* from THIS file via envDir='..'.
#   - Docker reads it via env_file / build-args (see docker-compose.yml).
# .env is gitignored — never commit real secrets.
# NOTE: anything VITE_*-prefixed is baked into the public JS bundle. Never give
# a secret a VITE_ prefix.
# =============================================================================

# --- Helius (required) -------------------------------------------------------
HELIUS_API_KEY={your_helius_api_key_here}
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key={your_helius_api_key_here}
# Dedicated Helius Sender endpoint for submitting transactions (send-only:
# supports sendTransaction only, NOT getLatestBlockhash/getSignatureStatus —
# those keep going to HELIUS_RPC_URL). Dual-routes to Jito + SWQoS staked
# connections in parallel; 0 credits; no api-key needed. Pick the regional HTTP
# endpoint nearest your server: http://<region>-sender.helius-rpc.com/fast
#   regions: slc ewr lon fra ams sg tyo. Requires a Jito tip AND a priority fee.
HELIUS_FAST_SENDER_URL=http://fra-sender.helius-rpc.com/fast
# Optional multi-endpoint fan-out: a comma-separated list of sender endpoints.
# The SAME signed tx is submitted to all of them concurrently — identical
# signature, so the bank dedups on-chain and the Jito tip is paid at most once;
# extra submissions only add landing paths, never cost. A slow/down endpoint
# can't gate the send (first acceptance wins; the rest finish in the background).
# When set, this OVERRIDES the singular var above. Recommended: the regional
# endpoint nearest your server first, plus a neighbor for redundancy. Leave
# unset to keep the single-endpoint path. Do NOT use ?swqos_only=true here for
# snipes (it drops the Jito auction path).
# HELIUS_FAST_SENDER_URLS=http://fra-sender.helius-rpc.com/fast,http://ams-sender.helius-rpc.com/fast

# --- Ingest transport: LaserStream (Yellowstone gRPC) -----------------------
# The live ingest transport (reconnect replay; raw txs stored in
# raw_transactions with source='live'). Needs a Business/Professional Helius plan.
# Regional LaserStream gRPC endpoint; pick the region NEAREST your server. Auth
# reuses HELIUS_API_KEY via x-token. REQUIRED.
# Format: https://laserstream-mainnet-<region>.helius-rpc.com
# Regions: fra ams lon | ewr pitt slc lax | tyo sg
HELIUS_LASERSTREAM_URL=https://laserstream-mainnet-<region>.helius-rpc.com

# --- Solana / wallet (required) ---------------------------------------------
# NOTE: the Pump.fun program ID is a fixed protocol constant in code
# (config/constants.rs::PUMP_FUN_PROGRAM_ID), so it is NOT configured here.
# Hot wallet private key used to sign trades. SENSITIVE — keep this secret.
WALLET_PRIVATE_KEY=your_base58_private_key
# Comma-separated list of durable-nonce account pubkeys.
NONCE_ACCOUNTS=pubkey1,pubkey2

# NOTE: trading tuning (priority fee, seed-pool size, compute-unit limit, Jito
# tip, retry/confirm counts) and the price-feed URLs / poll interval / HTTP
# timeout are hardcoded in code (pump-trader crate + backend services), not env.

# --- Database ---------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=meme_bot
# NOTE: under docker compose, DATABASE_URL/HOST/PORT are set in docker-compose.yml
# and override anything here. This value is for running the backend WITHOUT docker.
DATABASE_URL=postgres://postgres:change_me@localhost:5432/meme_bot
# Host port the dockerized postgres is published on (container side stays 5432).
# Set to a free port if 5432 is already taken on the host (e.g. a native Postgres).
POSTGRES_HOST_PORT=5555

# Connection pools. Three workload-isolated pools so no class of work can starve
# another ("pool timed out while waiting for an open connection"):
#   DB_MAX_CONNECTIONS        → hot path (ingest DbWriter, StrategyRunner, maintenance, seed, caches)
#   DB_API_MAX_CONNECTIONS    → HTTP API (fast dashboard list/detail/count reads, settings, mutations)
#   DB_BATCH_MAX_CONNECTIONS  → batch    (grouped sweeps' corpus load + writer, tpsl backtests)
#
# Size these to the pool's ACTUAL concurrency need, NOT up to the server ceiling.
# On a RAM-constrained box every open connection is a Postgres backend process
# (~26MB) competing with the 256MB shared_buffers pool. Fewer connections is MORE
# stable. The hot path needs only ~METRIC_WRITE_CONCURRENCY (6) writers; the API
# pool needs only as many concurrent dashboard requests as the 2-worker HTTP server
# can handle; batch work runs LOCAL only. Raise only in step with RAM, keeping the
# sum well under POSTGRES_MAX_CONNECTIONS (80).
DB_MAX_CONNECTIONS=12
DB_MIN_CONNECTIONS=2
DB_API_MAX_CONNECTIONS=8
DB_API_MIN_CONNECTIONS=1
DB_BATCH_MAX_CONNECTIONS=2
DB_BATCH_MIN_CONNECTIONS=1
# Seconds to wait for a free connection before erroring (per acquire). The API
# pool also enforces an 8s per-statement timeout (< this) so a slow query frees
# its slot before queued requests time out — see storage/postgres.rs.
DB_ACQUIRE_TIMEOUT_SECS=10
# Postgres server-side ceiling + cache (consumed by docker-compose.yml). The
# ceiling only needs to exceed the app-pool sum + external clients; the cache
# (shared_buffers) is the real lever on a small box — give Postgres as much as the
# co-located backend leaves free.
POSTGRES_MAX_CONNECTIONS=80
POSTGRES_SHARED_BUFFERS=256MB

# --- Backend HTTP server (optional; defaults shown) -------------------------
HOST=127.0.0.1
PORT=8081
HTTP_ENABLED=true
HTTP_WORKERS=2
# NOTE: CORS allow-origin is hardcoded in backend/src/main.rs (CORS_ALLOWED_ORIGIN).

# --- API auth (REQUIRED) -----------------------------------------------------
# Bearer token gating all mutating (POST/PUT/DELETE/PATCH) API routes — including
# the real-SOL buy/sell endpoints. The auth middleware is FAIL-CLOSED: without a
# token the backend refuses to start, so mutating routes can never be exposed by
# a forgotten env var. Clients must send `Authorization: Bearer <token>`.
# Generate a fresh secret, e.g.:  head -c 32 /dev/urandom | base64
API_AUTH_TOKEN=generate_a_long_random_secret_here

# --- Frontend (VITE_*; baked into the static bundle — no secrets here) -------
# Empty => SPA calls relative /api (Vite dev proxy / nginx forwards it).
VITE_API_BASE=
VITE_POLL_INTERVAL_MS=2000
# Dev-server only: Vite port and where /api is proxied (must match HOST:PORT).
VITE_DEV_PORT=5173
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8081
