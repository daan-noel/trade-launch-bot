# =============================================================================
# Copy to .env and fill in. .env is gitignored — never commit real secrets.
#   - Bins read this via dotenvy (panic on startup if a required var is missing).
#   - Docker reads it via env_file / ${VAR} substitution (docker-compose.yml).
# =============================================================================

# --- Database ---------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=launch_platform
# Host port the dockerized postgres is published on (container side stays 5432).
# 5556 by default so it coexists with the sibling meme-trading stack (5555).
POSTGRES_HOST_PORT=5556
# Connection string the bins use when run WITHOUT docker (host → published port).
DATABASE_URL=postgres://postgres:change_me@localhost:5556/launch_platform

# Pool sizing (carried pattern: workload-isolated hot/api/batch pools). Keep the
# sum well under POSTGRES_MAX_CONNECTIONS. Filled/consumed in Phase 3.
# DB_MAX_CONNECTIONS=12
# DB_API_MAX_CONNECTIONS=8
# DB_BATCH_MAX_CONNECTIONS=2

# --- HTTP -------------------------------------------------------------------
# live and lab bind different ports so both can run locally at once.
LIVE_HOST=127.0.0.1
LIVE_PORT=8091
LAB_HOST=127.0.0.1
LAB_PORT=8092

# --- Helius (LIVE only — ingest + execution; not needed to run `lab`) -------
# HELIUS_API_KEY={your_helius_api_key_here}
# HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key={your_helius_api_key_here}
# Regional LaserStream gRPC endpoint (Yellowstone). Auth reuses HELIUS_API_KEY.
# Regions: fra ams lon | ewr pitt slc lax | tyo sg
# HELIUS_LASERSTREAM_URL=https://laserstream-mainnet-<region>.helius-rpc.com
# Dedicated send endpoint (regional /fast). Requires a Jito tip + priority fee.
# HELIUS_FAST_SENDER_URL=http://fra-sender.helius-rpc.com/fast

# --- Managed wallets (LIVE only, Phase 5+) ----------------------------------
# SECURITY: Postgres stores only a key_ref (keystore path / KMS key id / envelope-
# encrypted blob). NEVER a raw private key. Signing goes through pump-trader's
# Arc<dyn Signer>. This var points at the external keystore, not a key itself.
# WALLET_KEYSTORE=

# --- PostgreSQL server tuning overrides (docker-compose) ---------------------
# TIMESCALEDB_MAX_BG_WORKERS=2
# POSTGRES_MAX_CONNECTIONS=80
# POSTGRES_SHARED_BUFFERS=1GB
# POSTGRES_EFFECTIVE_CACHE_SIZE=2GB

# --- Lake (LAB only, later) -------------------------------------------------
# Directory the sealed-day Parquet lake is written to / read from (workstation).
# SWEEP_LAKE_DIR=./lake-data
