# -----------------------------------------------------------------------------
# Backend environment variables
# -----------------------------------------------------------------------------
# Helius API key for Solana websocket ingestion and transaction streaming.
HELIUS_API_KEY=your_helius_api_key_here
# Helius subscription method used to receive transaction events.
SUBSCRIPTION_METHOD=transactionSubscribe

# Postgres database connection string used by the backend service.
# Format: postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://postgres:password@localhost:5432/meme_bot

# Solana on-chain program ID used to identify pump program transactions.
PUMP_PROGRAM_ID=6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P
# Connection timing values for Helius websocket keepalive/reconnect behavior.
# PING_INTERVAL is how often the backend sends a WS ping in milliseconds.
PING_INTERVAL=15000
# RECONNECT_INTERVAL is how long to wait before reconnecting after a drop.
RECONNECT_INTERVAL=1000

# Backend HTTP server bind settings.
HOST=127.0.0.1
PORT=8081

# -----------------------------------------------------------------------------
# Frontend environment variables
# -----------------------------------------------------------------------------
# Base URL the frontend uses to call the backend API.
API_BASE=http://127.0.0.1:8081
# Polling interval used by the frontend to refresh data in milliseconds.
POLL_INTERVAL_MS=5000
