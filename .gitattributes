# ============================================================================
# Monorepo root attributes. The former per-repo .gitattributes (meme-trading/)
# still applies within its subtree; these rules cover the monorepo root files
# (root Cargo.lock, root .dockerignore) and everything both products share.
# ============================================================================

# Keep every Cargo.lock byte-identical across Windows (dev) and Linux (EC2/Docker)
# so cargo-chef's recipe.json — and the dependency build cache — stays stable.
Cargo.lock -text
**/Cargo.lock -text

# Docker reads these line-by-line: a CRLF leaves a trailing \r on every pattern
# (so `target/\r` never matches `target/` and the multi-GB target dirs ship into
# the context) and breaks Dockerfile parsing. Force LF.
.dockerignore text eol=lf
**/.dockerignore text eol=lf
Dockerfile text eol=lf
**/Dockerfile text eol=lf
*.Dockerfile text eol=lf

# Shell scripts must stay LF to run in Linux containers / on the EC2 host.
*.sh text eol=lf
