# ============================================================================
# Monorepo root attributes. The former per-repo .gitattributes (hunter/)
# still applies within its subtree; these rules cover the monorepo root files
# (root Cargo.lock, root .dockerignore) and everything both products share.
# ============================================================================

# Keep every Cargo.lock byte-identical across Windows (dev) and Linux (EC2/Docker)
# so cargo-chef's recipe.json — and the dependency build cache — stays stable.
Cargo.lock -text
**/Cargo.lock -text

# Docker reads these line-by-line: a CRLF leaves a trailing \r on every pattern
# (so `target/\r` never matches `target/` and the multi-GB target dirs ship into
# the context) and breaks Dockerfile parsing. Force LF.
.dockerignore text eol=lf
**/.dockerignore text eol=lf
Dockerfile text eol=lf
**/Dockerfile text eol=lf
*.Dockerfile text eol=lf

# Shell scripts must stay LF to run in Linux containers / on the EC2 host.
*.sh text eol=lf

# Migrations are checksummed BY CONTENT: sqlx stores SHA-384 of the file bytes in
# `_sqlx_migrations` (and our lab runner in `_lab_migrations`), so a CRLF checkout
# on Windows and an LF checkout in the Linux build container would hash the SAME
# migration differently -- the local bin and the EC2 bin would each refuse the
# other's ledger, and db-incremental-sync copies that ledger between them. Force LF
# so the checksum is platform-stable.
**/migrations/*.sql text eol=lf
