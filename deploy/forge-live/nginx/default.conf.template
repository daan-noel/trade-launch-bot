# ---------------------------------------------------------------------------
# forge-live nginx — serves the built forge SPA (entry index.html) and
# reverse-proxies /api to the live backend container. TLS-terminating: HTTPS on
# 443, plain HTTP on 80 redirects up to HTTPS.
#
# This is a *.template: the forge backend now runs the same fail-closed bearer
# gate as hunter (it moves treasury SOL), so nginx must inject ${API_AUTH_TOKEN}
# into the /api proxy's Authorization header. The nginx image entrypoint runs
# envsubst over /etc/nginx/templates/*.template at startup, writing the result to
# /etc/nginx/conf.d/default.conf. NGINX_ENVSUBST_FILTER (set in compose) limits
# substitution to just API_AUTH_TOKEN so nginx's own $host/$remote_addr runtime
# vars survive untouched.
# ---------------------------------------------------------------------------

# Plain HTTP -> redirect everything to HTTPS. No auth here so the redirect
# itself never prompts for credentials.
server {
    listen 80;
    server_name _;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name _;

    # Self-signed cert for local/testing (regenerate with openssl; see
    # nginx/tls/). Swap in a real cert for production.
    ssl_certificate     /etc/nginx/tls/cert.pem;
    ssl_certificate_key /etc/nginx/tls/key.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    root /usr/share/nginx/html;
    index index.html;

    # HTTP Basic Auth gate for the whole site (SPA + /api). The location blocks
    # below inherit these directives. Credentials live in nginx/.htpasswd
    # (bcrypt), copied into the image by the UI Dockerfile.
    auth_basic           "Restricted";
    auth_basic_user_file /etc/nginx/.htpasswd;

    # Backend API. No trailing slash on proxy_pass => the /api/ prefix is
    # preserved, matching the backend's /api/... routes. The live backend
    # listens on ${LIVE_API_PORT} and is reached by its compose service name `live-api`.
    location /api/ {
        proxy_pass http://live-api:${LIVE_API_PORT};
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Bridge the browser's Basic-Auth login to the backend's fail-closed
        # bearer auth: replace the inbound `Authorization: Basic ...` with the
        # backend's bearer token so mutating (real-SOL) routes are accepted.
        # ${API_AUTH_TOKEN} is substituted at container start by the nginx image's
        # envsubst entrypoint (NGINX_ENVSUBST_FILTER restricts it to this var, so
        # the `$host`/`$remote_addr` runtime vars above are left untouched). The
        # token stays server-side — it is never sent to the browser.
        proxy_set_header Authorization     "Bearer ${API_AUTH_TOKEN}";
        proxy_read_timeout 300s;
    }

    # SPA fallback: let react-router handle client-side routes by serving the
    # entry document for any non-file, non-/api path.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
