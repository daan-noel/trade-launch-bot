# ---------------------------------------------------------------------------
# hunter-live nginx — serves the built React SPA and reverse-proxies /api to the
# backend container (see ui.Dockerfile). The SPA calls /api/... same-origin, so
# no CORS and no hardcoded backend URL.
#
# ONE server block listens on BOTH plain HTTP (80) and TLS (443). There is NO
# HTTP->HTTPS redirect: this stack publishes the UI on NON-standard host ports
# (the 8·F·C·P scheme -> ${LIVE_UI_HTTP_PORT:-8110} http / ${LIVE_UI_HTTPS_PORT:-8111}
# https, never 80/443), and several UIs share one box, so a `return 301
# https://$host...` would drop the non-standard port and dead-end the browser on
# :443. Instead both schemes serve the app directly. Reach it at
# http://<host>:8110 (plain) or https://<host>:8111 (self-signed TLS).
#
# *.template: the nginx image entrypoint runs envsubst over
# /etc/nginx/templates/*.template at startup, writing the result to
# /etc/nginx/conf.d/default.conf. This injects ${API_AUTH_TOKEN} and
# ${LIVE_API_PORT} (passed as env vars by compose). NGINX_ENVSUBST_FILTER (set
# in compose) limits substitution to those vars so nginx's own $host/$remote_addr
# runtime vars survive untouched.
# ---------------------------------------------------------------------------

server {
    listen 80;
    listen 443 ssl;
    http2 on;
    server_name _;

    # Self-signed cert for local/testing (regenerate with openssl; see
    # nginx/tls/). Used only by the TLS (443) listener; plain HTTP ignores it.
    # Swap in a real cert for production.
    ssl_certificate     /etc/nginx/tls/cert.pem;
    ssl_certificate_key /etc/nginx/tls/key.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    root /usr/share/nginx/html;
    index index.html;

    # HTTP Basic Auth gate for the whole site (SPA + /api). The location blocks
    # below inherit these directives. Credentials live in nginx/.htpasswd
    # (bcrypt), copied into the image by the frontend Dockerfile.
    auth_basic           "Restricted";
    auth_basic_user_file /etc/nginx/.htpasswd;

    # Backend API. No trailing slash on proxy_pass => the /api/ prefix is
    # preserved, matching the backend's /api/... routes.
    #
    # Variable + Docker embedded DNS (127.0.0.11): nginx otherwise resolves
    # `live-api` once at start and caches the IP. After `live-api` is recreated
    # it gets a new IP → every /api request 502s until the UI container restarts.
    # `valid=10s` re-resolves; `ipv6=off` matches the compose IPv4 network.
    location /api/ {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $api_upstream http://live-api:${LIVE_API_PORT};
        proxy_pass $api_upstream;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Bridge the browser's Basic-Auth login to the backend's fail-closed
        # bearer auth: replace the inbound `Authorization: Basic ...` with the
        # backend's bearer token so mutating (real-SOL) routes are accepted.
        # ${API_AUTH_TOKEN} is substituted at container start by the nginx image's
        # envsubst entrypoint (NGINX_ENVSUBST_FILTER restricts it to this var, so
        # the `$host`/`$remote_addr` runtime vars above are left untouched). The
        # token stays server-side — it is never sent to the browser.
        proxy_set_header Authorization     "Bearer ${API_AUTH_TOKEN}";
        proxy_read_timeout 300s;
    }

    # SPA fallback: let react-router handle client-side routes.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
