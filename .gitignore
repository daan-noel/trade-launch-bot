# ============================================================================
# Monorepo root .gitignore — merges hunter + forge.
# Each product folder also keeps its own nested .gitignore (comes in via the
# subtree import); this root file is the cross-cutting superset + safety net.
# NOTE: Cargo.lock is intentionally COMMITTED (binary/app, deterministic deps,
# cargo-chef Docker layer cache) — do NOT ignore it.
# ============================================================================

# --- Rust build output ---
target/
target-check/
**/*.rs.bk

# --- Node / frontend ---
# NOTE: package-lock.json is intentionally COMMITTED (like Cargo.lock above) —
# the frontend Docker images build with `npm ci`, which REQUIRES a committed,
# in-sync lockfile for reproducible installs. Ignoring it let forge's lockfile
# drift incomplete (missing Linux platform binaries) and broke `npm ci`.
node_modules/
dist/
build/
.vite/
*.tsbuildinfo
.pnp
.pnp.js
coverage/

# --- Temp / scratch / runtime lock files ---
# Policy: all transient temp files and runtime/OS/process lock files are ignored.
# NOT dependency lockfiles — package-lock.json (ends in .json, unaffected below)
# and Cargo.lock (re-included via the negation) are deliberately COMMITTED so
# `npm ci` / cargo builds stay reproducible; see the Cargo.lock note up top.
*.tmp
*.temp
*.bak
*~
~$*
.~lock.*
*.pid
postmaster.pid
*.wal
*.db-shm
*.db-wal
*.lock
!Cargo.lock

# --- Env / secrets / keys ---
.env
.env.backup
.env.local
.env.*.local
*.pem
*.ppk
aws.pub
.mcp.json
keystore/
wallet-backups/
wallet-backups/**/keystore/
# Envelope-encrypted wallet blobs — ignore by TYPE too, not just by keystore/
# location (defense in depth; matches .dockerignore's **/*.enc exclusion).
*.enc

# --- Data lake / parquet / sweep artifacts ---
*.parquet
/lake-data
.lake/
sweep-out/
tpsl2-sweep-out/
venv

# --- TLS (self-signed, generated locally) ---
nginx/tls/*.pem

# --- Editor / OS ---
.vscode/
.idea/
*.iml
*.swp
*.swo
*~
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Claude Code (project-local settings + worktrees) ---
.claude/

# --- DB dumps / snapshots ---
/*.dump
/snapshots
*.rar
*.zip
*.7z
.cache/

# --- Monorepo migration backup (local only, never commit) ---
/_monorepo-backup/
