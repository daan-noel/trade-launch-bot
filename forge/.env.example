# =============================================================================
# Copy to .env and fill in. .env is gitignored — never commit real secrets.
#   - Bins read this via dotenvy (panic on startup if a required var is missing).
#   - Docker reads it via env_file / ${VAR} substitution (deploy/forge.compose.yml).
# Keep this file schema-identical to .env (same keys, same order) — only values differ.
# =============================================================================

# --- Database ---------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=forge_bot
# (postgres host-publish port lives in the PORTS block below, as DB_PORT.)
# Connection string the bins use WITHOUT docker (host → published port). Under
# docker, compose sets DATABASE_URL and overrides this.
DATABASE_URL=postgres://postgres:change_me@localhost:5556/forge_bot
# Workload-isolated connection pools (hot / api / batch). Keep the sum well under
# POSTGRES_MAX_CONNECTIONS — each open PG backend competes for RAM on the EC2 box.
DB_MAX_CONNECTIONS=12
DB_MIN_CONNECTIONS=1
DB_API_MAX_CONNECTIONS=8
DB_API_MIN_CONNECTIONS=1
DB_BATCH_MAX_CONNECTIONS=2
DB_BATCH_MIN_CONNECTIONS=0
# Seconds to wait for a free connection before erroring (per acquire).
DB_ACQUIRE_TIMEOUT_SECS=10
# Postgres server-side ceiling + shared-buffer cache (consumed by compose).
POSTGRES_MAX_CONNECTIONS=80
POSTGRES_SHARED_BUFFERS=1GB

# --- Logging ----------------------------------------------------------------
RUST_LOG=live=info,sqlx=error,actix_server=warn

# --- HTTP -------------------------------------------------------------------
# live and lab bind different ports so both can run locally at once. Values MATCH
# the deploy LIVE_API_PORT / LAB_API_PORT below, so `cargo run` and docker use the
# SAME backend port. In docker, compose injects HOST/PORT (0.0.0.0 bind) which
# take precedence over these anyway.
LIVE_HOST=127.0.0.1
LIVE_PORT=8230
LAB_HOST=127.0.0.1
LAB_PORT=8240

# --- PORTS (deploy/forge.compose.yml — shared deploy server) -----------------
# Every host/service port in ONE place. Number scheme  8·F·C·P :
#   8 fixed · F=family (1 hunter, 2 forge) · C=component (1 live-ui, 3 live-api,
#   4 lab-api) · P=protocol (0 http, 1 https; api uses 0).
#   e.g. 8211 = forge·live-ui·https ; 8240 = forge·lab-api. DB keeps 5555/5556.
# forge-lab is API-only (no lab-ui), so forge omits the LAB_UI_* pair. Ports are
# offset from hunter's (deploy/hunter.compose.yml) and collision-free with it.
# live-api is NOT host-published (reached only through nginx); lab-api IS (direct
# access + `run --rm` batch). To make compose read these (not just its built-in
# defaults), pass --env-file:
#   docker compose --env-file forge/.env -f deploy/forge.compose.yml up -d --build
DB_PORT=5556             # postgres  (host -> container 5432)
LIVE_UI_HTTP_PORT=8210   # live nginx UI, published
LIVE_UI_HTTPS_PORT=8211
LIVE_API_PORT=8230       # live backend: container bind + nginx upstream (NOT host-published)
LAB_API_PORT=8240        # lab  backend: container bind + host-published (no UI/nginx for forge lab)

# Bearer token gating mutating (POST/PUT/DELETE/PATCH) forge-live routes. FAIL-CLOSED:
# REQUIRED for the live HTTP server to boot (forge-live moves treasury SOL). nginx
# bridges the browser's Basic-auth login to this token so only the proxy reaches
# launch/fund/manage. Generate a long random secret, e.g. `openssl rand -base64 32`.
API_AUTH_TOKEN=generate_a_long_random_secret_here

# --- Helius / Solana (LIVE only — ingest + execution; not needed for `lab`) --
HELIUS_API_KEY={your_helius_api_key_here}
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key={your_helius_api_key_here}
# Regional LaserStream gRPC endpoint (Yellowstone). Regions: fra ams lon | ewr
# pitt slc lax | tyo sg.
HELIUS_LASERSTREAM_URL=https://laserstream-mainnet-<region>.helius-rpc.com
# Dedicated send endpoint (regional /fast). Requires a Jito tip + priority fee.
HELIUS_FAST_SENDER_URL=http://fra-sender.helius-rpc.com/fast
# Comma-separated durable-nonce account pubkeys (required for the launcher dev-buy path).
NONCE_ACCOUNTS=pubkey1,pubkey2

# --- Launcher / keystore ----------------------------------------------------
# Directory of envelope-encrypted wallet blobs (Postgres stores only a key_ref,
# NEVER a raw key). Encrypt one: cargo run -p forge-live -- wallet-encrypt ./dev.json dev-01.enc
WALLET_KEYSTORE=./keystore
# Passphrase for the envelope KEK that wraps ed25519 secrets at rest (ADR D3).
LAUNCHER_KEK_PASSPHRASE=change_me
# Jito block-engine URL (global mainnet). Used for the leader-schedule poll
# (getNextScheduledLeader) and as the fallback submit URL when the regional list below
# is unset.
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf/api/v1/bundles
# MULTI-REGION submit fan-out (optional). Comma-separated regional block-engine URLs;
# the same signed bundle is raced across all of them and lands via whichever region
# reaches the leader first. The txs share signatures, so on-chain inclusion is deduped
# — racing regions can only land the bundle once (no double-spend). Unset → single
# submit to JITO_BLOCK_ENGINE_URL. Pick the 2-4 regions nearest the EC2 box.
# JITO_BLOCK_ENGINE_URLS=https://amsterdam.mainnet.block-engine.jito.wtf/api/v1/bundles,https://frankfurt.mainnet.block-engine.jito.wtf/api/v1/bundles,https://ny.mainnet.block-engine.jito.wtf/api/v1/bundles
# How many times the confirm watcher re-bids a `dropped` bundle at a HIGHER Jito
# tip before conceding. Each re-bid climbs the live tip-floor ladder (p95, p99, …)
# so a bundle that lost the auction bids up to win the next slot. 0 disables auto
# re-bid (a drop stays dropped for a manual POST /api/bundles/{id}/execute).
# Default 2 → up to 3 total attempts. The per-attempt tip is sized to Jito's live
# landed-tip floor and clamped to the trader's [min_sol, max_sol] cost guardrail.
BUNDLE_MAX_RETRIES=2
# Jito tip sizing for the ATOMIC launch bundle (create tx0 + co-buy legs land in
# ONE bundle). The whole-bundle auction tip rides the create leg, sized from Jito's
# live landed-tip feed at the escalation level and clamped to [MIN, MAX]. PERCENTILE
# is the first-attempt target (25|50|75|95|99); re-bids climb above it. Jito orders
# bundles by tip, so the co-buy legs do NOT each need a big tip — keep those tiny
# (they're set in personas.rs; the create-leg tip below is the auction bid).
# SIZING: the primary drop cause is leader-slot timing (a Jito validator must be the
# slot leader), addressed by the leader-schedule gate in bundle_execute.rs — NOT tip
# magnitude. But on a genuinely contested launch the live feed's winning bid can
# exceed a low ceiling, so the band is sized to let the API-driven tip actually reach
# a competitive level rather than silently capping. PERCENTILE=95 targets a
# win-this-slot bid on the first attempt (re-bids climb to p99+); MAX=0.005 is the
# hard cost guardrail the p95→p99 ladder clamps to. A tip only costs SOL once the
# bundle lands, so a higher ceiling is free until it actually wins. Feed 2026-07:
# p75=0.00001, p95=0.00005, p99=0.0008 SOL. MIN≈p95 (cheap cold-feed insurance).
JITO_MIN_TIP_SOL=0.00005
JITO_MAX_TIP_SOL=0.005
JITO_TIP_PERCENTILE=95
# Jito LEADER-SCHEDULE GATE (the primary stability fix). A Jito bundle can only land
# when a Jito validator is the slot leader; firing into a non-Jito slot drops it no
# matter the tip. Before every submit (first attempt AND each re-bid) the launcher
# polls the block engine's getNextScheduledLeader and waits — bounded — until a Jito
# leader is within SEND_WITHIN_SLOTS of the current slot. Fail-open: any RPC error or
# a spent MAX_WAIT_MS budget submits anyway, so a launch is never blocked.
#   ENABLED    — master switch; false reverts to ungated submit.
#   MAX_WAIT_MS— hard cap on the wait (bounds worst-case launch latency).
#   SEND_WITHIN_SLOTS — submit once a Jito leader is this many slots out (~450ms/slot;
#                       the block engine forwards to the upcoming leader, so firing a
#                       slot or two early is correct).
JITO_LEADER_GATE_ENABLED=true
JITO_LEADER_MAX_WAIT_MS=2000
JITO_LEADER_SEND_WITHIN_SLOTS=2
# Persistent launch Address Lookup Table. REQUIRED for create_v2 + dev-buy: that
# combo names ~27 accounts and overflows the 1232 B legacy-tx limit (Helius /fast
# → "base64 encoded too large"). With an ALT the create is compiled as a v0 tx and
# fits (~931 B). Provision it once (spends ~0.001 SOL), then paste the printed addr:
#   cargo run -p forge-live -- create-alt <authority_key_ref>
# Empty = legacy path (fine for create-only / create_v1; create_v2+dev-buy will fail).
PUMP_LAUNCH_ALT=
# Shared secret gating POST /api/wallet_pool/{id}/export (raw base58 key export).
# Empty HARD-DISABLES the endpoint (403). The response is spendable — serve over TLS.
WALLET_EXPORT_SECRET=generate_a_long_random_secret_here
# Wallet-pool backup root: every generate batch copies non-retired keystore blobs +
# a managed_wallets export here. MUST stay separate from LAUNCHER_KEK_PASSPHRASE.
WALLET_BACKUP_DIR=./wallet-backups
# Pinata JWT for pinning token-metadata images/JSON to IPFS (metadata-template
# authoring). Only POST /api/metadata_templates needs it.
PINATA_JWT=your_pinata_jwt_here

# --- Wallet funding (LIVE only — autonomous real-SOL spend) -----------------
#     Treasury -> pool top-up (docs/wallet-funding-plan.md). Powers the Fund button
#     + background funder. Needs a managed_wallets row with role='treasury'.
# Master kill switch. false = Fund button AND background funder both off.
FUND_ENABLED=false
# Test mode: log intended transfers, send NOTHING. Dry pass before flipping live.
FUND_DRY_RUN=false
# Never spend any one treasury below this floor (lamports). Default 0.05 SOL.
FUND_TREASURY_RESERVE_LAMPORTS=50000000
# Hard stop once this much is sent in one funding pass (lamports). Default 1 SOL.
FUND_MAX_SPEND_PER_INTERVAL_LAMPORTS=1000000000
# Warm-pool flat per-wallet amounts (JIT "fund for launch" ignores these and
# derives from the template). Defaults 0.05 / 0.03 SOL.
FUND_AMOUNT_DEV_LAMPORTS=50000000
FUND_AMOUNT_BUNDLER_LAMPORTS=30000000
# Amount jitter fraction (each transfer = amount * (1 ± this)). Default 0.15.
FUND_AMOUNT_JITTER_PCT=0.15
# Max random inter-send delay in ms (timing de-correlation). Default 8000.
FUND_MAX_DELAY_MS=8000
# Keep at least this many `funded` wallets warm per role. Set both 0 for pure JIT.
FUND_TARGET_FUNDED_DEV=2
FUND_TARGET_FUNDED_BUNDLER=5

# --- Post-launch token management (LIVE only — real sells) ------------------
#     Reading holdings + previewing a plan are always allowed; EXECUTING requires
#     this kill switch (token-management-plan.md).
# Master kill switch. false = POST /api/tokens/:mint/manage/execute is 503.
MANAGE_ENABLED=false
# Test mode: log intended sells, place NO trades. Dry pass before live.
MANAGE_DRY_RUN=false
# Slippage floor (bps) on each management sell. Default 10% (thin curves).
MANAGE_SELL_SLIPPAGE_BPS=1000
# Manage buy/sell fee/tip — decoupled from launch (operator-timed, not a slot race).
# Manage txs go via plain RPC, so priority fee is the only landing lever and a Jito
# tip is a no-op transfer (wasted). CU price is micro-lamports/CU (fee = price × CU
# limit); default 50000 keeps a curve sell's priority fee sub-0.00001 SOL. Tip stays
# 0 unless you route manage back through a real bundle/sender. Default 50000/0/0.
MANAGE_CU_PRICE_MICRO_LAMPORTS=50000
MANAGE_JITO_MIN_TIP_SOL=0.0
MANAGE_JITO_MAX_TIP_SOL=0.0
