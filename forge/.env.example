# =============================================================================
# forge config template — copy to .env and fill in.
#   - Bins read it via dotenvy (they PANIC on startup if a required var is missing).
#   - Docker reads it via env_file / ${VAR} (deploy/forge.compose.yml).
#   - .env is gitignored; never commit real secrets.
# Keep this file schema-identical to .env: same keys, same order — only values differ.
# =============================================================================

# =========================== Database ========================================

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=forge_bot

# Connection string for running bins WITHOUT docker (host -> published DB_PORT).
# Under docker, compose sets DATABASE_URL and overrides this.
DATABASE_URL=postgres://postgres:change_me@localhost:5556/forge_bot

# Workload-isolated pools (hot / api / batch). Keep their sum well under
# POSTGRES_MAX_CONNECTIONS — every open backend costs RAM on the EC2 box.
DB_MAX_CONNECTIONS=12
DB_MIN_CONNECTIONS=1
DB_API_MAX_CONNECTIONS=8
DB_API_MIN_CONNECTIONS=1
DB_BATCH_MAX_CONNECTIONS=2
DB_BATCH_MIN_CONNECTIONS=0

# Seconds to wait for a free connection before erroring (per acquire).
DB_ACQUIRE_TIMEOUT_SECS=10

# Postgres server-side ceiling + shared-buffer cache (read by compose).
POSTGRES_MAX_CONNECTIONS=80
POSTGRES_SHARED_BUFFERS=1GB

# =========================== Logging =========================================

RUST_LOG=live=info,sqlx=error,actix_server=warn

# =========================== HTTP server (local dev bind) ====================
# live and lab bind different ports so both can run locally at once. These match
# LIVE_API_PORT / LAB_API_PORT below, so `cargo run` and docker use the same port.
# Under docker, compose injects HOST/PORT (0.0.0.0 bind) and overrides these.

LIVE_HOST=127.0.0.1
LIVE_PORT=8230

LAB_HOST=127.0.0.1
LAB_PORT=8240

# =========================== Deploy ports (forge.compose.yml) ================
# Every host/service port in ONE place. Scheme  8·F·C·P :
#   8 fixed · F=family (1 hunter, 2 forge) · C=component (1 live-ui, 3 live-api,
#   4 lab-api) · P=protocol (0 http, 1 https; api uses 0).
#   e.g. 8211 = forge·live-ui·https ; 8240 = forge·lab-api. DB keeps 5555/5556.
# forge-lab is API-only (no lab-ui), so there is no LAB_UI_* pair. Ports are
# offset from hunter's and collision-free with them. live-api is NOT host-published
# (only nginx reaches it); lab-api IS (direct access + `run --rm` batch).
# Make compose read these (not just its built-in defaults) with --env-file:
#   docker compose --env-file forge/.env -f deploy/forge.compose.yml up -d --build
DB_PORT=5556             # postgres  (host -> container 5432)
LIVE_UI_HTTP_PORT=8210   # live nginx UI, published
LIVE_UI_HTTPS_PORT=8211
LIVE_API_PORT=8230       # live backend: container bind + nginx upstream (not host-published)
LAB_API_PORT=8240        # lab backend: container bind + host-published (forge lab has no nginx)

# =========================== API auth ========================================
# Bearer token gating every mutating (POST/PUT/DELETE/PATCH) forge-live route.
# FAIL-CLOSED: the live server refuses to boot without it (forge-live moves
# treasury SOL). nginx bridges the browser's Basic-auth login to this token so
# only the proxy reaches launch/fund/manage. Generate: openssl rand -base64 32

API_AUTH_TOKEN=generate_a_long_random_secret_here

# =========================== Helius / Solana (LIVE only) =====================
# Ingest + execution. Not needed for `lab`.

HELIUS_API_KEY={your_helius_api_key_here}
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key={your_helius_api_key_here}

# Regional LaserStream gRPC endpoint (Yellowstone).
# Regions: fra ams lon | ewr pitt slc lax | tyo sg.
HELIUS_LASERSTREAM_URL=https://laserstream-mainnet-<region>.helius-rpc.com

# Dedicated send endpoint (regional /fast). Requires a Jito tip + priority fee.
HELIUS_FAST_SENDER_URL=http://fra-sender.helius-rpc.com/fast

# Durable-nonce account pubkeys (comma-separated). Required by the launcher dev-buy path.
NONCE_ACCOUNTS=pubkey1,pubkey2

# =========================== Keystore & secrets ==============================

# Directory of envelope-encrypted wallet blobs (Postgres stores only a key_ref,
# never a raw key). Encrypt one:
#   cargo run -p forge-live -- wallet-encrypt ./dev.json dev-01.enc
WALLET_KEYSTORE=./keystore

# Passphrase for the envelope KEK that wraps ed25519 secrets at rest (ADR D3).
LAUNCHER_KEK_PASSPHRASE=change_me

# Shared secret gating POST /api/wallet_pool/{id}/export (raw base58 key export).
# Empty HARD-DISABLES the endpoint (403). The response is spendable — serve over TLS.
WALLET_EXPORT_SECRET=generate_a_long_random_secret_here

# Backup root: each generate batch copies non-retired keystore blobs + a
# managed_wallets export here. MUST stay separate from LAUNCHER_KEK_PASSPHRASE.
WALLET_BACKUP_DIR=./wallet-backups

# DEPLOY-ONLY (docker compose): the HOST directories bind-mounted into the
# live-api container at /keystore and /wallet-backups (see deploy/forge.compose.yml).
# Unused by a local `cargo run` — WALLET_KEYSTORE/WALLET_BACKUP_DIR above cover that.
# Put the copied `.enc` blobs in WALLET_KEYSTORE_HOST for a keystore restore; it must
# be encrypted with the same LAUNCHER_KEK_PASSPHRASE. Relative paths resolve relative
# to deploy/forge.compose.yml's directory (deploy/), NOT this file's directory — the
# default `../forge/keystore` means "the keystore/ folder at the repo root".
WALLET_KEYSTORE_HOST=../forge/keystore
WALLET_BACKUP_DIR_HOST=../forge/wallet-backups

# Pinata JWT for pinning token-metadata images/JSON to IPFS.
# Only POST /api/metadata_templates needs it.
PINATA_JWT=your_pinata_jwt_here

# =========================== Jito bundles & launch tx ========================

# Jito block-engine URL (global mainnet). Used for the leader-schedule poll
# (getNextScheduledLeader) and as the fallback submit URL when the regional
# list below is unset.
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf/api/v1/bundles

# MULTI-REGION submit fan-out (optional). Comma-separated regional block-engine
# URLs; the same signed bundle is raced across all of them and lands via whichever
# region reaches the leader first. Shared signatures dedupe on-chain, so racing
# can only land the bundle once (no double-spend). Unset -> single submit to
# JITO_BLOCK_ENGINE_URL. Pick the 2-4 regions nearest the EC2 box.
JITO_BLOCK_ENGINE_URLS=https://amsterdam.mainnet.block-engine.jito.wtf/api/v1/bundles,https://frankfurt.mainnet.block-engine.jito.wtf/api/v1/bundles,https://ny.mainnet.block-engine.jito.wtf/api/v1/bundles

# How many times the confirm watcher re-bids a `dropped` bundle at a HIGHER tip
# before conceding. Each re-bid climbs the live tip-floor ladder (p95, p99, ...).
# 0 disables auto re-bid (a drop then waits for a manual POST /api/bundles/{id}/execute).
# Default 2 -> up to 3 attempts. Each tip is clamped to [JITO_MIN_TIP_SOL, JITO_MAX_TIP_SOL].
BUNDLE_MAX_RETRIES=2

# Jito tip for the ATOMIC launch bundle (create tx0 + co-buy legs land in ONE
# bundle; the whole-bundle auction tip rides the create leg). Sized from Jito's
# live landed-tip feed at PERCENTILE (25|50|75|95|99), clamped to [MIN, MAX].
# Co-buy legs stay tiny (set in personas.rs) — Jito orders by total bundle tip.
# NOTE: the primary drop cause is leader-slot timing (handled by the leader gate
# below), NOT tip size. But a contested launch's winning bid can exceed a low cap,
# so the band lets the API-driven tip reach a competitive level. A tip only costs
# SOL once the bundle lands, so a higher ceiling is free until it wins.
# Feed 2026-07: p75=0.00001, p95=0.00005, p99=0.0008 SOL. MIN≈p95 = cheap insurance.
JITO_MIN_TIP_SOL=0.00005
JITO_MAX_TIP_SOL=0.005
JITO_TIP_PERCENTILE=95

# Jito LEADER-SCHEDULE GATE (the primary stability fix). A Jito bundle only lands
# when a Jito validator is the slot leader; firing into a non-Jito slot drops it
# regardless of tip. getNextScheduledLeader isn't on the public HTTP API, so before
# every submit (first attempt + each re-bid) the launcher derives it SOL-free:
# Solana RPC getSlotLeaders (upcoming leaders) intersected with the Jito validator
# set (JITO_VALIDATORS_URL). It waits — bounded — until a Jito identity leads within
# SEND_WITHIN_SLOTS. FAIL-OPEN: any RPC error, empty set, or spent budget submits anyway.
#   ENABLED           — master switch; false reverts to ungated submit.
#   MAX_WAIT_MS       — first-attempt wait cap. Each re-bid scales it up to 4x to hunt
#                       a Jito leader harder (an escalated tip is wasted on a non-Jito slot).
#   SEND_WITHIN_SLOTS — submit once a Jito leader is this many slots out (~450ms/slot).
#   VALIDATORS_URL    — Jito StakeNet identity feed; its identity_accounts are the match set.
JITO_LEADER_GATE_ENABLED=true
JITO_LEADER_MAX_WAIT_MS=2000
JITO_LEADER_SEND_WITHIN_SLOTS=2
JITO_VALIDATORS_URL=https://kobe.mainnet.jito.network/api/v1/validators

# Persistent launch Address Lookup Table. REQUIRED for create_v2 + dev-buy: that
# combo names ~27 accounts and overflows the 1232 B legacy-tx limit (Helius /fast
# -> "base64 encoded too large"). With an ALT the create compiles as a v0 tx (~931 B).
# Provision once (~0.001 SOL), then paste the printed address:
#   cargo run -p forge-live -- create-alt <authority_key_ref>
# Empty = legacy path (fine for create-only / create_v1; create_v2 + dev-buy will fail).
PUMP_LAUNCH_ALT=

# =========================== Wallet funding (LIVE only) ======================
# Autonomous real-SOL spend: treasury -> pool top-up (docs/wallet-funding-plan.md).
# Powers the Fund button + background funder. Needs a managed_wallets row role='treasury'.

# Master kill switch. false = Fund button AND background funder both off.
FUND_ENABLED=false

# Dry run: log intended transfers, send NOTHING. Do a dry pass before going live.
FUND_DRY_RUN=false

# Never spend a treasury below this floor (lamports). Default 0.05 SOL.
FUND_TREASURY_RESERVE_LAMPORTS=50000000

# Hard stop once this much is sent in one funding pass (lamports). Default 1 SOL.
FUND_MAX_SPEND_PER_INTERVAL_LAMPORTS=1000000000

# Warm-pool flat per-wallet amounts (JIT "fund for launch" ignores these and
# derives from the template). Defaults 0.05 / 0.03 SOL.
FUND_AMOUNT_DEV_LAMPORTS=50000000
FUND_AMOUNT_BUNDLER_LAMPORTS=30000000

# Amount jitter fraction: each transfer = amount * (1 ± this). Default 0.15.
FUND_AMOUNT_JITTER_PCT=0.15

# Max random inter-send delay, ms (timing de-correlation). Default 8000.
FUND_MAX_DELAY_MS=8000

# Keep at least this many `funded` wallets warm per role. Both 0 = pure JIT.
FUND_TARGET_FUNDED_DEV=2
FUND_TARGET_FUNDED_BUNDLER=5

# =========================== Post-launch token management (LIVE only) ========
# Real sells. Reading holdings + previewing a plan are always allowed; EXECUTING
# requires the kill switch (token-management-plan.md).

# Master kill switch. false = POST /api/tokens/:mint/manage/execute returns 503.
MANAGE_ENABLED=false

# Dry run: log intended sells, place NO trades. Do a dry pass before live.
MANAGE_DRY_RUN=false

# Slippage floor (bps) on each management sell. Default 10% (thin curves).
MANAGE_SELL_SLIPPAGE_BPS=1000

# Manage buy/sell fee/tip — decoupled from launch (operator-timed, not a slot race).
# Manage txs go via plain RPC, so priority fee is the only landing lever and a Jito
# tip is a wasted no-op transfer. CU price is micro-lamports/CU (fee = price × CU
# limit); 50000 keeps a curve sell's priority fee sub-0.00001 SOL. Keep tips 0
# unless you route manage through a real bundle/sender. Default 50000 / 0 / 0.
MANAGE_CU_PRICE_MICRO_LAMPORTS=50000
MANAGE_JITO_MIN_TIP_SOL=0.0
MANAGE_JITO_MAX_TIP_SOL=0.0
