# =============================================================================
# Copy to .env and fill in. .env is gitignored — never commit real secrets.
#   - Bins read this via dotenvy (panic on startup if a required var is missing).
#   - Docker reads it via env_file / ${VAR} substitution (docker-compose.yml).
# =============================================================================

# --- Database ---------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=launch_platform
# Host port the dockerized postgres is published on (container side stays 5432).
# 5556 by default so it coexists with the sibling meme-trading stack (5555).
POSTGRES_HOST_PORT=5556
# Connection string the bins use when run WITHOUT docker (host → published port).
DATABASE_URL=postgres://postgres:change_me@localhost:5556/launch_platform

# Pool sizing (carried pattern: workload-isolated hot/api/batch pools). Keep the
# sum well under POSTGRES_MAX_CONNECTIONS. Filled/consumed in Phase 3.
# DB_MAX_CONNECTIONS=12
# DB_API_MAX_CONNECTIONS=8
# DB_BATCH_MAX_CONNECTIONS=2

# --- Logging (optional) -----------------------------------------------------
# Default when unset: live=info,sqlx=error (lab bin: lab=info,sqlx=error).
# RUST_LOG=live=info,sqlx=error,actix_server=warn

# --- HTTP -------------------------------------------------------------------
# live and lab bind different ports so both can run locally at once.
LIVE_HOST=127.0.0.1
LIVE_PORT=8091
LAB_HOST=127.0.0.1
LAB_PORT=8092
# In docker, compose injects HOST/PORT instead (bind 0.0.0.0 so nginx can reach
# the backend); HOST/PORT take precedence over LIVE_/LAB_ when both are present.

# Bearer token gating mutating (POST/PUT/DELETE/PATCH) API requests on slp-live.
# REQUIRED for the live HTTP server to boot (fail-closed — forge-live moves real
# treasury SOL). nginx bridges the browser's Basic-auth login to this token so
# only the proxy can reach the launch/fund/manage routes. Generate a long random
# secret (e.g. `openssl rand -base64 32`); the ui + api containers both read it.
API_AUTH_TOKEN=generate_a_long_random_secret_here

# --- Helius (LIVE only — ingest + execution; not needed to run `lab`) -------
# HELIUS_API_KEY={your_helius_api_key_here}
# HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key={your_helius_api_key_here}
# Regional LaserStream gRPC endpoint (Yellowstone). Auth reuses HELIUS_API_KEY.
# Regions: fra ams lon | ewr pitt slc lax | tyo sg
# HELIUS_LASERSTREAM_URL=https://laserstream-mainnet-<region>.helius-rpc.com
# Dedicated send endpoint (regional /fast). Requires a Jito tip + priority fee.
# HELIUS_FAST_SENDER_URL=http://fra-sender.helius-rpc.com/fast
# Comma-separated durable-nonce account pubkeys (required for launcher dev-buy path).
# NONCE_ACCOUNTS=
# Passphrase for envelope-encrypted dev/bundler wallet blobs (ADR D3).
# LAUNCHER_KEK_PASSPHRASE=
# Jito block-engine URL for post-launch sniper bundles (launcher only).
# JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf/api/v1/bundles
# Encrypt a dev keypair: cargo run -p slp-live -- wallet-encrypt ./dev.json dev-01.enc
# SECURITY: Postgres stores only a key_ref (keystore path / KMS key id / envelope-
# encrypted blob). NEVER a raw private key. Signing goes through pump-trader's
# Arc<dyn Signer>. This var points at the external keystore, not a key itself.
# WALLET_KEYSTORE=
# Verify a keystore blob decrypts to the expected address (restore runbook):
# cargo run -p slp-live -- wallet-verify <key_ref> <expected_address>
# Export a managed wallet's raw base58 private key (CLI restore/migration):
# cargo run -p slp-live -- wallet-export <wallet_id> --i-understand [--stdout]
# Shared secret gating the UI export endpoint POST /api/wallet_pool/{id}/export.
# Unset (default) HARD-DISABLES the endpoint (403). Set a long random value to
# enable the WalletPool "Export key" button; sent as the X-Export-Secret header.
# The response is spendable key material — serve the live API over TLS only.
# WALLET_EXPORT_SECRET=
# Wallet-pool backup root (optional — unset disables the post-generation
# backup entirely). Every batch generation copies non-retired keystore blobs +
# a managed_wallets export here. SECURITY: never point this at the same place
# as LAUNCHER_KEK_PASSPHRASE / any secret store — the KEK must stay separate
# from these backups. See docs/wallet-pool-plan.md Phase 4 for the restore
# runbook.
# WALLET_BACKUP_DIR=
# Pinata JWT for pinning token-metadata images/JSON to IPFS (metadata-template
# authoring, POST /api/metadata_templates). Get one from pinata.cloud → API Keys.
# Unset disables metadata-template creation only — nothing else needs it.
# PINATA_JWT=

# --- Wallet funding (LIVE only — autonomous real-SOL spend; see ------------
#     docs/wallet-funding-plan.md). Treasury -> pool top-up: keeps N `funded`
#     wallets warm per role + backs POST /api/wallet_pool/fund. OFF by default.
# Master kill switch. Unset/false = no background funder AND no manual endpoint.
# FUND_ENABLED=false
# Test mode: log intended transfers, send NOTHING. Run a dry pass before live.
# FUND_DRY_RUN=false
# Never spend ANY ONE treasury below this floor (lamports). Applied per-treasury —
# funding spills across ALL role=treasury wallets (docs/jit-funding-plan.md).
# Conservative buffer so each treasury stays a live, fee-payable wallet — NOT tied
# to the launch gate. Default 0.05 SOL.
# FUND_TREASURY_RESERVE_LAMPORTS=50000000
# Hard stop once this much is sent in one funding pass (aggregate across all source
# treasuries, lamports). Default 1 SOL.
# FUND_MAX_SPEND_PER_INTERVAL_LAMPORTS=1000000000
# WARM-POOL flat per-wallet amounts (background funder + plain Fund button). The JIT
# "Fund for launch" path IGNORES these and derives amounts per launch from the
# template (dev = 0.02 gate + dev-buy; bundler = leg buy + tip + fees). The dev-launch
# gate is 0.02 SOL (create rent + fees + tip; MIN_DEV_LAUNCH_LAMPORTS); the 0.05
# default funds that floor PLUS dev-buy headroom. Defaults 0.05 / 0.03 SOL.
# FUND_AMOUNT_DEV_LAMPORTS=50000000
# FUND_AMOUNT_BUNDLER_LAMPORTS=30000000
# Amount jitter fraction (warm-pool only — JIT funds the exact need, no jitter).
# Default 0.15.
# FUND_AMOUNT_JITTER_PCT=0.15
# Max random inter-send delay in ms (timing de-correlation). Default 8000.
# FUND_MAX_DELAY_MS=8000
# Keep at least this many `funded` wallets warm per role (background funder). Set
# BOTH to 0 to idle the warm funder under pure JIT. Defaults 2 / 5.
# FUND_TARGET_FUNDED_DEV=2
# FUND_TARGET_FUNDED_BUNDLER=5

# --- Post-launch token management (LIVE only — real sells; see ---------------
#     token-management-plan.md). Sell/buy/consolidate holdings across dev/bundler
#     wallets. Reading holdings + previewing a plan are ALWAYS allowed; EXECUTING
#     a plan (real trades) requires this kill switch. OFF by default.
# Master kill switch. Unset/false = POST /api/tokens/:mint/manage/execute is 503.
# MANAGE_ENABLED=false
# Test mode: log intended sells, place NO trades. Run a dry pass before live.
# MANAGE_DRY_RUN=false
# Slippage floor (bps) on each management sell — protects proceeds on a thin
# curve. Default 10% (managed tokens are often low-liquidity).
# MANAGE_SELL_SLIPPAGE_BPS=1000

# --- PostgreSQL server tuning overrides (docker-compose) ---------------------
# TIMESCALEDB_MAX_BG_WORKERS=2
# POSTGRES_MAX_CONNECTIONS=80
# POSTGRES_SHARED_BUFFERS=1GB
# POSTGRES_EFFECTIVE_CACHE_SIZE=2GB

# --- Lake (LAB only, later) -------------------------------------------------
# Directory the sealed-day Parquet lake is written to / read from (workstation).
# SWEEP_LAKE_DIR=./lake-data
